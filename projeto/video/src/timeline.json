 "legendas": [
  {
   "cena": 1,
   "text": "Fala, turma!",
   "start": 0.798,
   "end": 2.795
  },
  {
   "cena": 1,
   "text": "Se você esteve na internet essa semana,",
   "start": 2.795,
   "end": 5.069
  },
  {
   "cena": 1,
   "text": "com certeza ouviu essa frase:",
   "start": 5.069,
   "end": 6.902
  },
  {
   "cena": 1,
   "text": "\"Meu caráter não tem nada a ver com meu instinto.\"",
   "start": 6.902,
   "end": 9.836
  },
  {
   "cena": 2,
   "text": "O meme viralizou.",
   "start": 10.608,
   "end": 12.546
  },
  {
   "cena": 2,
   "text": "E na publicidade,",
   "start": 12.546,
   "end": 13.748
  },
  {
   "cena": 2,
   "text": "meme é atenção de graça.",
   "start": 13.748,
   "end": 15.998
  },
  {
   "cena": 2,
   "text": "Mas a pergunta é:",
   "start": 15.998,
   "end": 17.391
  },
  {
   "cena": 2,
   "text": "como usar isso sem queimar a marca?",
   "start": 17.391,
   "end": 19.896
  },
  {
   "cena": 3,
   "text": "A gente pegou só a estrutura da frase,",
   "start": 20.682,
   "end": 22.991
  },
  {
   "cena": 3,
   "text": "o contraste entre caráter e instinto,",
   "start": 22.991,
   "end": 25.122
  },
  {
   "cena": 3,
   "text": "e transformou em produto.",
   "start": 25.122,
   "end": 26.96
  },
  {
   "cena": 4,
   "text": "De um lado, o caráter:",
   "start": 27.732,
   "end": 29.541
  },
  {
   "cena": 4,
   "text": "econômico, seguro,",
   "start": 29.541,
   "end": 31.16
  },
  {
   "cena": 4,
   "text": "carro de família.",
   "start": 31.16,
   "end": 32.908
  },
  {
   "cena": 4,
   "text": "Do outro, o instinto:",
   "start": 32.908,
   "end": 34.479
  },
  {
   "cena": 4,
   "text": "zero a cem em sete segundos.",
   "start": 34.479,
   "end": 36.794
  },
  {
   "cena": 5,
   "text": "Isso constrói valor",
   "start": 37.566,
   "end": 38.637
  },
  {
   "cena": 5,
   "text": "porque o carro deixa de ser só transporte.",
   "start": 38.637,
   "end": 41.73
  },
  {
   "cena": 5,
   "text": "Ele vira identidade:",
   "start": 41.73,
   "end": 43.099
  },
  {
   "cena": 5,
   "text": "os dois lados de quem dirige.",
   "start": 43.099,
   "end": 45.282
  },
  {
   "cena": 6,
   "text": "Vértice Duo.",
   "start": 46.056,
   "end": 47.72
  },
  {
   "cena": 6,
   "text": "Os dois lados de você,",
   "start": 47.72,
   "end": 49.303
  },
  {
   "cena": 6,
   "text": "num carro só.",
   "start": 49.303,
   "end": 50.982
  },
  {
   "cena": 6,
   "text": "Valeu, turma!",
   "start": 50.982,
   "end": 52.796
  }
 ]
